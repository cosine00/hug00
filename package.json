{
  "name": "hux-ink-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hugo blog + serverless comment system (Cloudflare Workers + D1)",
  "scripts": {
    "comments:dev": "wrangler dev",
    "comments:db:local": "wrangler d1 execute blog-comment --local --file=worker/schema.sql",
    "comments:db:init": "wrangler d1 execute blog-comment --remote --file=worker/schema.sql",
    "comments:deploy": "wrangler deploy",
    "comments:export": "node scripts/comments-export.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
