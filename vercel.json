      "destination": "/beta/",
      "permanent": false
    },
    {
      "source": "/update",
      "destination": "/beta/",
      "permanent": false
    },
    {
      "source": "/update/",
      "destination": "/beta/",
      "permanent": false
    }
  ]
}
